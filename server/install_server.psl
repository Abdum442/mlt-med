# Define the paths and variables
$postgresqlUrl = "https://get.enterprisedb.com/postgresql/postgresql-16.0-1-windows-x64.exe"
$pgDir = "C:\Program Files\PostgreSQL\16"
$dataDir = "$pgDir\data"
$pgUser = "mlt"
$pgDb = "mltdb"
$pgPassword = "mlttrading"
$serverDir = "."
$pm2Config = "$serverDir\pm2.config.js"

# Step 1: Install fnm (Fast Node Manager)
# Function to check if a command exists
function CommandExists {
    param (
        [string]$command
    )
    $commandCheck = Get-Command $command -ErrorAction SilentlyContinue
    return $commandCheck -ne $null
}

# Check if Node.js is installed
if (CommandExists "node") {
    Write-Output "Node.js is already installed. Version: $(node -v)"
} else {
    # Install fnm (Fast Node Manager)
    Write-Output "Node.js is not installed. Installing Node.js..."
    winget install Schniz.fnm

    # Install Node.js using fnm
    fnm use --install-if-missing 18

    # Verify Node.js installation
    if (CommandExists "node") {
        Write-Output "Node.js installed successfully. Version: $(node -v)"
    } else {
        Write-Error "Failed to install Node.js"
        exit 1
    }
}

# Step 2: Check if npm is installed
if (CommandExists "npm") {
    Write-Output "npm is already installed. Version: $(npm -v)"
} else {
    Write-Error "npm should be installed with Node.js. Please check the Node.js installation."
    exit 1
}

# Step 3: Install PostgreSQL
Write-Host "Installing PostgreSQL..."
Invoke-WebRequest -Uri $postgresqlUrl -OutFile "postgresql.exe"
Start-Process -FilePath "postgresql.exe" -ArgumentList "--mode unattended --superpassword postgres" -Wait
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error installing PostgreSQL."
    exit $LASTEXITCODE
}
Write-Host "PostgreSQL installed."

# Step 4: Initialize PostgreSQL Database
Write-Host "Initializing PostgreSQL database..."
& "$pgDir\bin\initdb.exe" -D $dataDir --username=postgres
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error initializing PostgreSQL database."
    exit $LASTEXITCODE
}
Write-Host "PostgreSQL database initialized."

# Start PostgreSQL Server
& "$pgDir\bin\pg_ctl.exe" -D $dataDir start
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error starting PostgreSQL server."
    exit $LASTEXITCODE
}
Write-Host "PostgreSQL server started."

# Step 5: Create the database and user
Write-Host "Creating database and user..."
& "$pgDir\bin\psql.exe" -U postgres -c "CREATE USER $pgUser WITH PASSWORD '$pgPassword';"
& "$pgDir\bin\psql.exe" -U postgres -c "CREATE DATABASE $pgDb OWNER $pgUser;"
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error creating database and user."
    exit $LASTEXITCODE
}
Write-Host "Database and user created."

# Step 6: Create tables and seed user data
Write-Host "Creating tables and seeding user data..."
$schemaFile = "$serverDir\db_init\schema.sql"
$usersFile = "$serverDir\db_init\users.sql"
& "$pgDir\bin\psql.exe" -U $pgUser -d $pgDb -f $schemaFile
& "$pgDir\bin\psql.exe" -U $pgUser -d $pgDb -f $usersFile
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error creating tables and seeding user data."
    exit $LASTEXITCODE
}
Write-Host "Tables created and user data seeded."

# Step 7: Install pm2 globally
Write-Host "Installing pm2..."
npm install -g pm2
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error installing pm2."
    exit $LASTEXITCODE
}
Write-Host "pm2 installed."

# Step 8: Install server dependencies
Write-Host "Installing server dependencies..."
Set-Location -Path $serverDir
npm install
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error installing server dependencies."
    exit $LASTEXITCODE
}
Write-Host "Server dependencies installed."

# Step 9: Start server with pm2
Write-Host "Starting server with pm2..."
pm2 start $pm2Config
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error starting server with pm2."
    exit $LASTEXITCODE
}
Write-Host "Server started with pm2."

# Step 10: Configure Windows to start server at boot
Write-Host "Configuring Windows to start server at boot..."
pm2 startup
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error configuring pm2 startup."
    exit $LASTEXITCODE
}
pm2 save
if ($LASTEXITCODE -ne 0) {
    Write-Host "Error saving pm2 process list."
    exit $LASTEXITCODE
}
Write-Host "Windows configured to start server at boot."

Write-Host "Installation completed successfully."
